#!/usr/bin/env bash
set -euo pipefail
compliance_root="$(cd "$(dirname "$0")/.." && pwd)"
compliance_sdk="$compliance_root/.tools/flutter/bin/flutter"
# Homebrew JDKs may be installed without registration with /usr/libexec/java_home.
if [[ -z "${JAVA_HOME:-}" && -x /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home/bin/java ]]; then
  export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
fi
if [[ -z "${ANDROID_HOME:-}" && -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
if [[ -x "$compliance_sdk" ]]; then
  exec "$compliance_sdk" --suppress-analytics "$@"
fi
if command -v flutter >/dev/null 2>&1; then
  exec flutter --suppress-analytics "$@"
fi
printf '%s\n' 'Flutter 3.50.1이 필요합니다. README.md의 개발 환경 안내를 확인하세요.' >&2
exit 127
